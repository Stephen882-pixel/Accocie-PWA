# Client-side values. Everything VITE_-prefixed is baked into the bundle and is
# therefore public — never put a secret here. Copy to .env.local to use.

VITE_ACOCIE_APP_NAME=Acocie Stores
VITE_ACOCIE_APP_ENV=development
VITE_ACOCIE_API_URL=http://localhost:5002/api/v1
VITE_ACOCIE_API_TIMEOUT=10000
